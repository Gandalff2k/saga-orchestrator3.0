          },
          "refId": "A",
          "expr": "sum by (outcome) (increase(saga_duration_seconds_count[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
