# Running a service on the host against `docker compose up` infra.
# Copy to .env and export, e.g. in Git Bash: set -a; source .env; set +a
SERVICE_NAME=inventory-worker
APP_ENV=local
LOG_FORMAT=text
LOG_LEVEL=debug
OPS_ADDR=:8081

KAFKA_BROKERS=localhost:9092,localhost:9094,localhost:9095
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

POSTGRES_DSN=postgres://saga:saga@localhost:5432/inventory?sslmode=disable
CONSUMER_GROUP=inventory
CONSUMER_TOPICS=inventory.commands

# sagactl migrate
ORCHESTRATOR_DSN=postgres://saga:saga@localhost:5432/orchestrator?sslmode=disable
INVENTORY_DSN=postgres://saga:saga@localhost:5432/inventory?sslmode=disable
PAYMENT_DSN=postgres://saga:saga@localhost:5432/payment?sslmode=disable
